
# --- CERF dev overrides ---

bind 127.0.0.1

# Only accept local connections (systemd will still allow localhost access)
protected-mode yes

# Default Redis port
port 6379

# Disable persistence – pure in-memory cache
save ""
appendonly no

# Do NOT daemonize under systemd
daemonize no

# Disable safety write locks from failed RDB saves
stop-writes-on-bgsave-error no

# Logging to stdout (systemd captures it)
logfile ""
