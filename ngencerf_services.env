# This file defines environment variables which control various aspects of the 
# ngenCERF services, like how it connects to its database. Create a copy of this 
# file named ngencerf_services.override.env to change any of the values used by the
# application.

## ngenCERF DB connection variables ##
CERF_SERVER_DATABASE_NAME=postgres
CERF_SERVER_DATABASE_USER=postgres
CERF_SERVER_DATABASE_PASSWORD=postgres
CERF_SERVER_DATABASE_HOST=db
