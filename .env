# Docker doesn't give us a way to get this automatically.
# We need to know the path of the user's directory that maps to NGEN_CAL_MOUNT_POINT
NGEN_CAL_DATA_PATH=/ngencerf-app/data/ngen-cal-data/

# Add external S3 data mount for ngen-forcing data
FORCING_DATA_MOUNT_PATH=/ngwpc-forcing
FORCING_DATA_S3_PATH=/ngwpc-forcing

# Add external S3 data mount for ngwpc-hydrofabric data
HF_DATA_MOUNT_PATH=/ngwpc-hydrofabric
HF_DATA_S3_PATH=/ngwpc-hydrofabric
