# This is the base environment file for Parallel Works which is copied to cerfServer/.env in the Docker file
# This file is source-controlled.  No deployment-specific data should be in here.
# The only values in here are those values which are static and the same regardless of deployment
# There are placeholders for values which should be defined in thed deployment-specific .env-override file

# The .env-override file is not source-controlled.  There is no sample or template file

CERF_SERVER_DATABASE_NAME=postgres
CERF_SERVER_DATABASE_PASSWORD=postgres

CERF_SERVER_SQL_LOGGING=False

SLURM_URL='http://172.17.0.1:5000'

# SECURITY WARNING: don't run with debug turned on in production!
DJANGO_DEBUG=False

NGEN_ENVIRONMENT=PARALLEL_WORKS

ENTERPRISE_DATA_URL='http://hydroapi.test.nextgenwaterprediction.com:8000'

REDIS_URL=redis://redis:6379/1

# ---------------------------
# Cluster specific data below which should be defined in the deployment-specific .env-override
# ----------------------------

# Secret key should be unique for each deployment
CERF_SERVER_SECRET_KEY=

# Each cluster must define its own unique directory under s3://ngwpc-ngencerf-archive
# It is also important to create a dummy file in the directory since empty directories on S3 are ephemeral.  See README
# NGENCERF_ARCHIVE_S3_PATH=s3://ngwpc-ngencerf-archive/integration/
NGENCERF_ARCHIVE_S3_PATH=
